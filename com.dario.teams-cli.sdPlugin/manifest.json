{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.dario.teams-cli",
  "Name": "Teams CLI",
  "Version": "0.1.0.0",
  "Author": "Dario",
  "Description": "Controls Microsoft Teams microphone, camera, and call ending using the local teams-cli executable.",
  "Category": "Teams CLI",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Actions": [
    {
      "UUID": "com.dario.teams-cli.mic-status",
      "Name": "Microphone status",
      "Tooltip": "Shows Teams microphone status. Press to toggle mute using Teams CLI.",
      "Icon": "imgs/category",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "DisableAutomaticStates": true,
      "DisableCaching": true,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "States": [
        {
          "Image": "imgs/unknown",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.dario.teams-cli.camera-status",
      "Name": "Camera status",
      "Tooltip": "Shows Teams camera status. Press to toggle the camera using Teams CLI.",
      "Icon": "imgs/camera",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "DisableAutomaticStates": true,
      "DisableCaching": true,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "States": [
        {
          "Image": "imgs/camera-unknown",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.dario.teams-cli.call-end",
      "Name": "End call",
      "Tooltip": "Leave your active Teams call using Teams CLI.",
      "Icon": "imgs/call",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "DisableAutomaticStates": true,
      "DisableCaching": true,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "States": [
        {
          "Image": "imgs/call-end",
          "ShowTitle": false
        }
      ]
    }
  ]
}
